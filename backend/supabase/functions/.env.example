# Copy to .env (same folder) for local Edge Functions. Never commit .env.
# Hosted: set these with `supabase secrets set KEY=value` instead.

# Leave empty (or set MOCK_DECISIONS=true) to use fake answers: no OpenAI calls, no cost.
OPENAI_API_KEY=
MOCK_DECISIONS=true

# Free live AI (publishable key): salt for hashing caller IPs (required for
# deploy; generate once with `openssl rand -hex 32` and keep it, or today's
# per-IP counts reset).
IP_HASH_SALT=

# Optional overrides
# LIVE_AI_FREE_SECONDS_PER_MONTH=1200  # per browser install (20 min)
# LIVE_AI_IP_SECONDS_PER_DAY=1200      # per network (20 min)
# DECISIONS_MODEL=gpt-6-luna
# FLAG_THRESHOLD=0.5
