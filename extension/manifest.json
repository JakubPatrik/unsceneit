{
  "manifest_version": 3,
  "name": "unscene.it: Safe YouTube Content Filter & Blur",
  "version": "0.1.1",
  "description": "YouTube content filter: blur scenes with gore, spiders or anything above your age limit, plus thumbnails. The story keeps playing.",
  "homepage_url": "https://unscene.it",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_title": "unscene.it filters",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "site.js",
        "tee-flag.js",
        "thumbs.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "css": [
        "thumbs.css"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "mse-tee.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "logic.js",
        "notice.js",
        "content.js",
        "debug.js",
        "prescan.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
