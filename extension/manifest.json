{
  "manifest_version": 3,
  "name": "SceneMod",
  "version": "0.1.0",
  "description": "Hides or skips scenes that match your content filters, using AI analysis of video frames.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "SceneMod filters",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "tee-flag.js",
        "thumbs.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "css": [
        "thumbs.css"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "mse-tee.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "logic.js",
        "notice.js",
        "content.js",
        "debug.js",
        "prescan.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
