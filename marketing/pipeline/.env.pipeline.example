# Copy to .env.pipeline (gitignored) and fill in. Nothing here is needed for
# `lint`, `render` or a dry run; it's only needed for --live.

# Buffer: create the key at https://publish.buffer.com/settings/api
BUFFER_API_KEY=""

# Run `python run_pipeline.py channels` to list these IDs. If this Buffer account
# also holds other brands, make sure these are the unscene.it channels. Platforms
# left empty are skipped.
BUFFER_ORG_ID=""
BUFFER_CHANNEL_YOUTUBE=""
BUFFER_CHANNEL_TIKTOK=""
BUFFER_CHANNEL_INSTAGRAM=""
BUFFER_CHANNEL_X=""

# Media hosting. Buffer has no upload endpoint: it fetches each video from a
# public URL when the post goes out. `cleanup` deletes the file once it's sent.
# The secret key is in the Supabase dashboard: Project Settings > API Keys. It has
# full access to the project, so keep it in this file only.
SUPABASE_URL="https://sankeqoeuociotbufbsb.supabase.co"
SUPABASE_SECRET_KEY=""
# The public bucket to use. It's created on first upload if it doesn't exist.
SUPABASE_BUCKET="marketing-media"

# Or, instead of Supabase, any public host you sync yourself. The pipeline expects
# <MEDIA_BASE_URL>/<creative id>.mp4 and won't delete anything there:
MEDIA_BASE_URL=""
